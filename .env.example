# ──────────────────────────────────────────────────────────────────────────────
# Market Service — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Market Service"
APP_VERSION="0.1.0"
APP_ENV=development          # development | staging | production
DEBUG=true                   # Set to false in production

# ── Security (Stateless JWT Verification) ──────────────────────────────────────
SECRET_KEY=change-me-use-a-long-random-string-in-production
ALGORITHM=HS256

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/trading_db
POSTGRES_PASSWORD=password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Market Provider APIs ───────────────────────────────────────────────────────
FINNHUB_API_KEY=your-finnhub-api-key

# ── CORS & Hosts ───────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
ALLOWED_HOSTS=["*"]

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# ── Internal Service Communication (Agent 5) ──────────────────────────────────
MARKET_SERVICE_INTERNAL_SECRET=change-me
